# Submodulos do LifeBusinessSuit.
#
# Este arquivo FALTAVA. O indice ja tinha os gitlinks (modo 160000) dos quatro
# apps, mas sem o .gitmodules o `git submodule update --init` nao tem de onde
# tirar a URL: quem clonasse o repositorio recebia quatro diretorios VAZIOS e
# nenhuma mensagem util. Reconstruido em 27/08/2026, junto com a entrada nova
# do LBSNotify.
#
# `branch` esta preenchido porque a suite e mista de proposito — LBS_MoneyAPP,
# LBS_TodoAPP e LBS_NotifyAPP usam `main`; LBS_NotesAPP e LBS_TTSAPP, `master`.
# Nada foi renomeado para uniformizar: o valor aqui tem que ser o que existe no
# remoto, senao `git submodule update --remote` falha.

[submodule "LBS_NotifyAPP"]
	path = LBS_NotifyAPP
	url = https://github.com/moablive/LBS_NotifyAPP.git
	branch = main

[submodule "LBS_TTSAPP"]
	path = LBS_TTSAPP
	url = https://github.com/moablive/LBS_TTSAPP.git
	branch = master

[submodule "LBS_MoneyAPP"]
	path = LBS_MoneyAPP
	url = https://github.com/moablive/LBS_MoneyAPP.git
	branch = main

[submodule "LBS_NotesAPP"]
	path = LBS_NotesAPP
	url = https://github.com/moablive/LBS_NotesAPP.git
	branch = master

[submodule "LBS_TodoAPP"]
	path = LBS_TodoAPP
	url = https://github.com/moablive/LBS_TodoAPP.git
	branch = main
