# Secrets
.env
.env.*
*.env
shared.env
deploy/*.env
**/notify.env

# Logs
*.log
logs/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Node / Python / build artifacts
node_modules/
dist/
build/
coverage/
__pycache__/
*.pyc

# Docker / runtime
*.pid
*.sock
tmp/
temp/

# Runtime / transient deploy files
deploy/*.pid
deploy/*.tmp
deploy/*.log

# Keep subprojects, but ignore their git internals in this root repo
MoneyAPP/.git
NotesAPP/.git
TodoAPP/.git
MailAPP/.git

# Optional: ignore all nested git dirs in this backup repo
**/.git
# Segredos: valor real so no .env local; o repo versiona apenas o exemplo
.env
.env.*
!.env.example

# Store local do pnpm: e cache de pacote, nao codigo. Versionado, ele trouxe
# ~20k arquivos de terceiros para dentro do repositorio — inclusive README e
# fixture de pacote com chave de exemplo, que o gitleaks acusa como vazamento a
# cada varredura, escondendo achado de verdade no meio do ruido.
.pnpm-store/

# O settings.local.json do Claude acumula os comandos executados, e ja entrou
# em commit carregando token da Cloudflare e senha do Postgres (junho/2026).
# Fica fora do git, sempre.
.claude/settings.local.json
